# VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_LARAVEL_API_URL: The URL of the Laravel backend API
VITE_LARAVEL_API_URL="http://localhost:8000"

# VITE_MIDTRANS CONFIGURATION
VITE_MIDTRANS_SERVER_KEY="YOUR_MIDTRANS_SERVER_KEY"
VITE_MIDTRANS_CLIENT_KEY="YOUR_MIDTRANS_CLIENT_KEY"


# Set to "true" for Production, "false" for Sandbox/Test environment
MIDTRANS_IS_PRODUCTION="false"

# RESEND CONFIGURATION
# Obtain your API key from https://resend.com
# Add this to the "Secrets" panel in the AI Studio Settings menu.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
